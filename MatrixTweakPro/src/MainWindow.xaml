<Window x:Class="MatrixTweakPro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MatrixTweakPro.Controls"
        Title="Matrix Tweak Pro" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Width="1000" Height="600">
    <Grid>
        <controls:MatrixRainControl x:Name="Rain"/>
        <Grid Margin="40" Background="#AA000000">
            <TextBlock Text="Matrix Tweak Pro" Foreground="Lime" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Top"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20">
                <Button x:Name="PreviewButton" Content="Preview" Width="100" Margin="10" Click="Preview_Click"/>
                <Button x:Name="ApplyButton" Content="Apply" Width="100" Margin="10" Click="Apply_Click"/>
                <Button x:Name="RevertButton" Content="Revert" Width="100" Margin="10" Click="Revert_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
